{
  "name": "envirosphere",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "pnpm content:check && next build",
    "postbuild": "pnpm check:out",
    "check:out": "node scripts/check-out.mjs",
    "check:launch": "node scripts/check-launch.mjs",
    "start": "node server.mjs",
    "preview": "node server.mjs --port 4173",
    "content:check": "tsx scripts/content-check.ts",
    "optimize:images": "tsx scripts/optimize-images.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "image-size": "^2.0.4",
    "lenis": "1.3.27",
    "lucide-react": "^1.61.0",
    "motion": "14.6.0",
    "next": "16.4.2",
    "react": "19.2",
    "react-dom": "19.2",
    "react-markdown": "10.1.0",
    "tailwind-merge": "^3.7.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "serve": "^14.2.6",
    "sharp": "^0.35.5",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
