# Hostinger (LiteSpeed/Apache) rules for the static export. CSP is added in Plan 5.
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Force HTTPS (skip when TLS terminates at a proxy/CDN that sends X-Forwarded-Proto)
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # /about → /about/ (matches trailingSlash: true)
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Raise to 31536000 (+ includeSubDomains if all subdomains are HTTPS) once the live site is verified.
  Header always set Strict-Transport-Security "max-age=300"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # Hashed build files never change; HTML and owner-replaceable media must stay fresh.
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(svg|jpg|jpeg|png|gif|ico|webp|avif|mp4|pdf)$">
    Header set Cache-Control "public, max-age=86400, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(html|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
