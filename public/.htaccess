# Hostinger (LiteSpeed/Apache) rules for the static export
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Force HTTPS (skip when TLS terminates at a proxy/CDN that sends X-Forwarded-Proto)
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # /about -> /about/ (matches trailingSlash: true)
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  # ===== SECURITY HEADERS: single source of truth (server.mjs mirrors these exact values) =====
  # Next's static export emits inline hydration scripts and style attributes, so
  # 'unsafe-inline' is unavoidable in script-src/style-src without per-request nonces
  # (not possible on a static host). Everything else is locked to 'self' + named origins.
  # HSTS is STAGED: max-age=300 (5 min). Once HTTPS is confirmed on every page for a week,
  # raise to 86400, then 2592000, then 31536000; add includeSubDomains only when ALL
  # subdomains serve HTTPS; add preload only as a deliberate final step (hard to undo).
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=300"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://script.google.com https://script.googleusercontent.com https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self';"
  # ===== END SECURITY HEADERS =====

  # Hashed build files never change; HTML and owner-replaceable media must stay fresh.
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(svg|jpg|jpeg|png|gif|ico|webp|avif|mp4|pdf)$">
    Header set Cache-Control "public, max-age=2592000, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(html|txt|xml)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml application/ld+json image/svg+xml
</IfModule>
